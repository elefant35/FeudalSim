{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feudalsim.dev/schemas/item.schema.json",
  "title": "ItemDef",
  "description": "A list of item definitions (generated from FeudalSim.Sim.Content.ItemDef; do not edit).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^item(\\.[a-z0-9_]\u002B)\u002B$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "enum": [
          "raw",
          "metal",
          "food",
          "drink",
          "tool",
          "weapon",
          "clothing",
          "container",
          "misc"
        ]
      },
      "tier": {
        "type": "string",
        "enum": [
          "t0",
          "t1",
          "t2",
          "t3",
          "t4"
        ]
      },
      "trade_unit": {
        "type": "string",
        "minLength": 1
      },
      "mass_kg": {
        "type": "number"
      },
      "base_value_f": {
        "type": "integer"
      },
      "durability": {
        "type": "integer"
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "toxin": {
        "type": "string",
        "minLength": 1
      },
      "wear": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "under",
              "torso",
              "legs",
              "feet",
              "cloak",
              "head",
              "hands"
            ]
          },
          "ins": {
            "type": "number"
          },
          "wet_retention": {
            "type": "number"
          },
          "rain_resist": {
            "type": "number"
          }
        },
        "required": [
          "slot",
          "ins",
          "wet_retention",
          "rain_resist"
        ],
        "additionalProperties": false
      },
      "stackable": {
        "type": "boolean"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "id",
      "name",
      "category",
      "tier",
      "trade_unit",
      "mass_kg",
      "base_value_f"
    ],
    "additionalProperties": false
  }
}
