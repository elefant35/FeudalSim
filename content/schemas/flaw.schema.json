{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feudalsim.dev/schemas/flaw.schema.json",
  "title": "FlawDef",
  "description": "A list of flaw definitions (generated from FeudalSim.Sim.Content.FlawDef; do not edit).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^flaw(\\.[a-z0-9_]\u002B)\u002B$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "cap": {
        "type": "integer"
      },
      "hidden_difficulty": {
        "type": "integer"
      },
      "effects": {
        "type": "object"
      },
      "fix": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "name",
      "cap",
      "hidden_difficulty"
    ],
    "additionalProperties": false
  }
}
