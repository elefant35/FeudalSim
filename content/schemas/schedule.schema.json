{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feudalsim.dev/schemas/schedule.schema.json",
  "title": "ScheduleDef",
  "description": "A list of schedule definitions (generated from FeudalSim.Sim.Content.ScheduleDef; do not edit).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^schedule(\\.[a-z0-9_]\u002B)\u002B$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "blocks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            },
            "block": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "from",
            "to",
            "block"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "name",
      "blocks"
    ],
    "additionalProperties": false
  }
}
