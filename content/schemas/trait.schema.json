{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feudalsim.dev/schemas/trait.schema.json",
  "title": "TraitDef",
  "description": "A list of trait definitions (generated from FeudalSim.Sim.Content.TraitDef; do not edit).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^trait(\\.[a-z0-9_]\u002B)\u002B$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "group": {
        "type": "string",
        "enum": [
          "temper",
          "morality",
          "social",
          "courage",
          "work",
          "ambition",
          "faith",
          "appetite"
        ]
      },
      "canon": {
        "type": "boolean"
      },
      "incompatible": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "prevalence": {
        "type": "number"
      },
      "facet_affinity": {
        "type": "object"
      },
      "effects": {
        "type": "object",
        "properties": {
          "emotion_gain": {
            "type": "object"
          },
          "half_life": {
            "type": "object"
          },
          "hijack_threshold": {
            "type": "object"
          },
          "utility": {
            "type": "object"
          },
          "need_decay": {
            "type": "object"
          },
          "tau": {
            "type": "number"
          },
          "susceptibility": {
            "type": "number"
          },
          "mood_baseline": {
            "type": "number"
          },
          "status_aspiration": {
            "type": "number"
          },
          "value_floor": {
            "type": "object"
          },
          "value_cap": {
            "type": "object"
          },
          "value_shift": {
            "type": "object"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "voice_phrase": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "name",
      "group"
    ],
    "additionalProperties": false
  }
}
