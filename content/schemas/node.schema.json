{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feudalsim.dev/schemas/node.schema.json",
  "title": "NodeDef",
  "description": "A list of node definitions (generated from FeudalSim.Sim.Content.NodeDef; do not edit).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^node(\\.[a-z0-9_]\u002B)\u002B$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "type": "string",
        "enum": [
          "tree",
          "bush",
          "rock",
          "patch"
        ]
      },
      "density": {
        "type": "object"
      },
      "edge_only": {
        "type": "boolean"
      },
      "lithology": {
        "type": "string",
        "minLength": 1
      },
      "sizes": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "wood": {
        "type": "object"
      },
      "seasons": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "toxic": {
        "type": "boolean"
      },
      "confusable": {
        "type": "string",
        "minLength": 1
      },
      "confusable_risk": {
        "type": "number"
      },
      "forage": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "integer"
          }
        },
        "required": [
          "item"
        ],
        "additionalProperties": false
      },
      "notes": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "name",
      "kind",
      "density"
    ],
    "additionalProperties": false
  }
}
