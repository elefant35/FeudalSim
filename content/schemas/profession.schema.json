{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feudalsim.dev/schemas/profession.schema.json",
  "title": "ProfessionDef",
  "description": "A list of profession definitions (generated from FeudalSim.Sim.Content.ProfessionDef; do not edit).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^profession(\\.[a-z0-9_]\u002B)\u002B$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "primary": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "secondary": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "tier": {
        "type": "string",
        "enum": [
          "t0",
          "t1",
          "t2",
          "t3",
          "t4"
        ]
      },
      "first_era": {
        "type": "integer"
      },
      "prestige": {
        "type": "integer"
      },
      "critical": {
        "type": "boolean"
      },
      "workplace": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "name",
      "primary",
      "tier",
      "first_era",
      "prestige"
    ],
    "additionalProperties": false
  }
}
