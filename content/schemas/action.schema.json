{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feudalsim.dev/schemas/action.schema.json",
  "title": "ActionDef",
  "description": "A list of action definitions (generated from FeudalSim.Sim.Content.ActionDef; do not edit).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^action(\\.[a-z0-9_]\u002B)\u002B$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "class": {
        "type": "string",
        "enum": [
          "p0",
          "p1",
          "p2",
          "p3",
          "p4"
        ]
      },
      "base_weight": {
        "type": "number"
      },
      "weight_need": {
        "type": "string",
        "minLength": 1
      },
      "place": {
        "type": "string",
        "enum": [
          "fire",
          "water",
          "stores",
          "shelter",
          "woods",
          "forage_ground",
          "home"
        ]
      },
      "duration_min": {
        "type": "integer"
      },
      "activity": {
        "type": "string",
        "enum": [
          "sleep",
          "rest",
          "light",
          "moderate",
          "heavy"
        ]
      },
      "need_per_hour": {
        "type": "object"
      },
      "consumes": {
        "type": "object",
        "properties": {
          "stock": {
            "type": "string",
            "minLength": 1
          },
          "ratio": {
            "type": "number"
          }
        },
        "required": [
          "stock",
          "ratio"
        ],
        "additionalProperties": false
      },
      "stock_per_hour": {
        "type": "object"
      },
      "requires": {
        "type": "object"
      },
      "until_need": {
        "type": "object"
      },
      "start_below": {
        "type": "object"
      },
      "skill": {
        "type": "string",
        "minLength": 1
      },
      "purposeful": {
        "type": "boolean"
      },
      "social": {
        "type": "boolean"
      },
      "schedule_block": {
        "type": "string",
        "minLength": 1
      },
      "utility_keys": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "facet_k": {
        "type": "object"
      },
      "stock_pressure": {
        "type": "object",
        "properties": {
          "stock": {
            "type": "string",
            "minLength": 1
          },
          "comfortable": {
            "type": "number"
          }
        },
        "required": [
          "stock",
          "comfortable"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "name",
      "class",
      "place",
      "duration_min",
      "activity"
    ],
    "additionalProperties": false
  }
}
