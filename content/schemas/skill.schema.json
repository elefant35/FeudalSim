{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feudalsim.dev/schemas/skill.schema.json",
  "title": "SkillDef",
  "description": "A list of skill definitions (generated from FeudalSim.Sim.Content.SkillDef; do not edit).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^skill(\\.[a-z0-9_]\u002B)\u002B$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "domain": {
        "type": "string",
        "enum": [
          "land",
          "craft",
          "social",
          "martial_body"
        ]
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "attributes": {
        "type": "object"
      }
    },
    "required": [
      "id",
      "name",
      "domain"
    ],
    "additionalProperties": false
  }
}
