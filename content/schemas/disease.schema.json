{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feudalsim.dev/schemas/disease.schema.json",
  "title": "DiseaseDef",
  "description": "A list of disease definitions (generated from FeudalSim.Sim.Content.DiseaseDef; do not edit).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^disease(\\.[a-z0-9_]\u002B)\u002B$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "routes": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "incubation_h": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "stages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "hours": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "contagious": {
              "type": "number"
            },
            "effects": {
              "type": "object"
            },
            "grave": {
              "type": "boolean"
            },
            "fever": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "hours"
          ],
          "additionalProperties": false
        }
      },
      "grave": {
        "type": "object",
        "properties": {
          "base": {
            "type": "number"
          },
          "mult": {
            "type": "object"
          }
        },
        "required": [
          "base"
        ],
        "additionalProperties": false
      },
      "immunity_days": {
        "type": "number"
      },
      "beta": {
        "type": "number"
      }
    },
    "required": [
      "id",
      "name",
      "incubation_h",
      "stages"
    ],
    "additionalProperties": false
  }
}
