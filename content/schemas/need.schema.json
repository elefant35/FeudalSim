{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feudalsim.dev/schemas/need.schema.json",
  "title": "NeedDef",
  "description": "A list of need definitions (generated from FeudalSim.Sim.Content.NeedDef; do not edit).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^need\\.[a-z0-9_]\u002B$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "type": "string",
        "enum": [
          "physical",
          "psychological"
        ]
      },
      "decay_per_hour": {
        "type": "object",
        "properties": {
          "sleep": {
            "type": "number"
          },
          "rest": {
            "type": "number"
          },
          "light": {
            "type": "number"
          },
          "moderate": {
            "type": "number"
          },
          "heavy": {
            "type": "number"
          }
        },
        "required": [
          "sleep",
          "rest",
          "light",
          "moderate",
          "heavy"
        ],
        "additionalProperties": false
      },
      "description": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "name",
      "kind"
    ],
    "additionalProperties": false
  }
}
