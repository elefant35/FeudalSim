# Copy to .env and fill in. .env is gitignored. Never commit real keys.
# Developer configuration only: shipped builds keep these in the in-game settings file and store
# API keys in the OS keychain (see docs/tech/22-llm-integration.md §3.3).

# --- Mode ---
# auto | cloud | local | template   (template = no LLM at all; the game must stay playable)
LLM_MODE=auto
# Gateway recording for tests/dev: live | record | replay (orthogonal to LLM_MODE)
AI_GATEWAY_MODE=live

# --- Dialogue / generative LLM (OpenAI-compatible chat completions endpoint) ---
# OpenRouter to start; later a local server (llama.cpp / Ollama / LM Studio).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Qwen instruct models on OpenRouter. VERIFY exact ids before use; thinking mode must be disabled.
LLM_DIALOGUE_MODEL=qwen/qwen3-14b
LLM_UTILITY_MODEL=qwen/qwen3-8b
LLM_CHRONICLE_MODEL=
LLM_TIMEOUT_TTFT_MS=3000
LLM_MAX_CONCURRENCY=4

# --- Local runtime (used when LLM_MODE=local, or as auto fallback) ---
LLM_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_DIALOGUE_MODEL=

# --- Decision / classifier model (Jev by TypeSafe, "System One") ---
# Model id and wire format come from third-party sources; VERIFY against TypeSafe docs first.
DECIDER_PROVIDER=openrouter        # openrouter | typesafe | local-llm | heuristic
DECIDER_BASE_URL=
DECIDER_MODEL=typesafe/jev-1.13
DECIDER_API_KEY=
DECIDER_TIMEOUT_MS=1200

# --- Budgets / safety ---
LLM_MAX_SPEND_USD_PER_SESSION=1.00
LLM_MAX_SPEND_USD_PER_MONTH=10.00
LLM_LOG_TRANSCRIPTS=false
