# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- Dialogue / generative LLM (OpenAI-compatible chat completions endpoint) ---
# OpenRouter to start; later point at a local server (llama.cpp / Ollama / LM Studio).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Pick a Qwen instruct model available on OpenRouter; confirm the exact id before use.
LLM_DIALOGUE_MODEL=qwen/qwen3-14b
LLM_UTILITY_MODEL=qwen/qwen3-8b

# --- Decision / classifier model (Jev by TypeSafe, "System One") ---
# Model id reported by third-party sources; VERIFY against TypeSafe/OpenRouter docs before implementation.
DECIDER_PROVIDER=openrouter        # openrouter | typesafe | local-llm | heuristic
DECIDER_MODEL=typesafe/jev-1.13
DECIDER_API_KEY=

# --- Budgets / safety ---
LLM_MAX_SPEND_USD_PER_SESSION=1.00
LLM_LOG_TRANSCRIPTS=false
