# Copy to .env and fill in. .env is gitignored. Never commit real keys.
# Developer configuration only: shipped builds keep these in the in-game settings file and store
# API keys in the OS keychain (see docs/tech/22-llm-integration.md §3.3).

# --- Keys ---
# Development uses a single OpenRouter key for both dialogue and the fast decider.
OPENROUTER_KEY=
# Optional override for a non-OpenRouter OpenAI-compatible endpoint (falls back to OPENROUTER_KEY).
LLM_API_KEY=
# Jev (TypeSafe) direct API, once access is granted (waitlisted). Leave empty until then.
TYPESAFE_API_KEY=

# --- Mode ---
# auto | cloud | local | template   (template = no LLM at all; the game must stay playable)
LLM_MODE=auto
# Gateway recording for tests/dev: live | record | replay (orthogonal to LLM_MODE)
AI_GATEWAY_MODE=live

# --- Dialogue / generative LLM (OpenAI-compatible chat completions endpoint) ---
# Model ids below were listed on OpenRouter on 2026-10-03 (prices as of that date, per million tokens).
# The M1 bake-off picks the final models. Thinking/reasoning mode must be disabled.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_DIALOGUE_MODEL=qwen/qwen3-14b              # $0.12 in / $0.24 out
# Bake-off candidates: qwen/qwen3-30b-a3b-instruct-2507 ($0.048/$0.193), qwen/qwen3.5-35b-a3b,
#                      qwen/qwen3.6-35b-a3b, qwen/qwen3.8-flash
LLM_UTILITY_MODEL=qwen/qwen3-8b                # $0.117 / $0.455 — barks, rumors, gists, letters
LLM_CHRONICLE_MODEL=
LLM_TIMEOUT_TTFT_MS=3000
LLM_MAX_CONCURRENCY=4

# --- Local runtime (used when LLM_MODE=local, or as auto fallback) ---
LLM_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_DIALOGUE_MODEL=

# --- Fast decider (choices among fixed options, with probabilities) ---
# openrouter-llm = small model; options labelled A/B/C..., probabilities read from first-token logprobs
#                  (requires provider.require_parameters=true). Verified working 2026-10-03.
# typesafe       = Jev decision model via TypeSafe's API (needs TYPESAFE_API_KEY; OpenRouter only
#                  exposes "typesafe/jev-router", which routes to other models and is NOT the decider).
# laya           = open-source local decider (pip install "laya[serve]"; laya-serve exposes POST /v1/systemone,
#                  the same API shape as Jev). Needs fine-tuning on our decision data before it's useful.
# local-llm | heuristic = offline fallbacks.
DECIDER_PROVIDER=openrouter-llm
DECIDER_MODEL=qwen/qwen3.5-9b                  # $0.10 / $0.15; ~$0.00001 per decision in testing
DECIDER_BASE_URL=                              # e.g. http://127.0.0.1:8000 for laya-serve
DECIDER_TIMEOUT_MS=1200

# --- Budgets / safety ---
LLM_MAX_SPEND_USD_PER_SESSION=1.00
LLM_MAX_SPEND_USD_PER_MONTH=10.00
LLM_LOG_TRANSCRIPTS=false
